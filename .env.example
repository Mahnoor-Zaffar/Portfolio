# EmailJS — contact form delivery (https://dashboard.emailjs.com)
# These are public client-side keys, not secrets. Lock down abuse with the
# domain allowlist in EmailJS → Account → Security.
#
# Local dev: copy this file to `.env.local` and fill in the values.
# Production: add the same three as GitHub Actions secrets (repo Settings →
# Secrets and variables → Actions).

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Analytics — GoatCounter (https://www.goatcounter.com), free & cookieless.
# Set to your site code (the `xxxx` in xxxx.goatcounter.com). Empty = disabled.
VITE_GOATCOUNTER_CODE=
