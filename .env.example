# PostHog project API key (starts with `phc_`). Required to enable analytics.
VITE_POSTHOG_KEY=phc_your_project_api_key

# Web3Forms access key for contact form (free at https://web3forms.com).
# Enter your email, get an access key, and paste it below.
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here
